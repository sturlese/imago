#!/usr/bin/env python3
"""Scaffold an Imago agent.

Agents never live in this repo. The definition goes to ~/.claude/agents/, where
Claude Code looks for it; the memory goes to ~/.imago/, which is deliberately a
separate tree — see the note on least privilege below. This script refuses to
write anywhere inside the template checkout.

    tools/new-agent phoebe --memory deliverable
    tools/new-agent --from-example toby

Why memory is not under ~/.claude: an agent can only write to a directory it has
been granted, and granting ~/.claude would hand it its own configuration, every
other agent's definition, and your settings. ~/.imago is a narrow grant.

Python 3.10+, standard library only.
"""

from __future__ import annotations

import argparse
import datetime as dt
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
TEMPLATES = REPO / "templates"
EXAMPLES = REPO / "examples"

NAME_RE = re.compile(r"^[a-z][a-z0-9-]{1,38}[a-z0-9]$")
SHAPES = ("deliverable", "caller")


def fail(msg: str, *hint: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    for line in hint:
        print(f"       {line}", file=sys.stderr)
    raise SystemExit(1)


def guard_not_in_repo(target: Path) -> None:
    """Refuse to scaffold inside the template checkout.

    This is the mechanical half of keeping your agents out of a pull request to
    the template. The other half is using "Use this template" on GitHub rather
    than cloning, so there is no upstream to open one against.
    """
    try:
        target.resolve().relative_to(REPO)
    except ValueError:
        return  # outside the repo, which is what we want
    fail(
        f"refusing to write inside the Imago template ({REPO})",
        "Definitions belong in ~/.claude/agents/ and memories in ~/.imago/, never",
        "in this repo — see the 'Where things live' table in README.md. Drop",
        "--agents-dir and --memory-dir to use the defaults.",
    )


def resolve_roots(agents_opt: str | None, memory_opt: str | None) -> tuple[Path, Path]:
    agents = Path(agents_opt).expanduser() if agents_opt else Path.home() / ".claude" / "agents"
    memory = Path(memory_opt).expanduser() if memory_opt else Path.home() / ".imago"
    guard_not_in_repo(agents)
    guard_not_in_repo(memory)
    return agents, memory


def render(text: str, name: str, shape: str) -> str:
    return (
        text.replace("{{NAME}}", name)
        .replace("{{MEMORY_SHAPE}}", shape)
        .replace("{{SLUG}}", name)
        .replace("{{DATE}}", dt.date.today().isoformat())
    )


def write_memory(memory_dir: Path, name: str) -> Path:
    memory_dir.mkdir(parents=True, exist_ok=True)
    index = memory_dir / "MEMORY.md"
    if not index.exists():
        index.write_text(
            render((TEMPLATES / "MEMORY.md").read_text(encoding="utf-8"), name, ""),
            encoding="utf-8",
        )
    return index


def main() -> int:
    p = argparse.ArgumentParser(
        prog="new-agent",
        description="Scaffold an Imago agent into ~/.claude/.",
    )
    p.add_argument("name", nargs="?", help="agent name (lowercase, hyphens)")
    p.add_argument(
        "--memory",
        choices=SHAPES,
        help="how the memory write happens; required unless --from-example",
    )
    p.add_argument(
        "--from-example",
        metavar="NAME",
        help=f"install a worked example from {EXAMPLES.name}/ instead of a blank template",
    )
    p.add_argument("--agents-dir", help="where the definition goes (default: ~/.claude/agents)")
    p.add_argument("--memory-dir", help="where the memory goes (default: ~/.imago)")
    p.add_argument("--force", action="store_true", help="overwrite an existing definition")
    args = p.parse_args()

    if args.from_example:
        name = args.name or args.from_example
        source = EXAMPLES / f"{args.from_example}.md"
        if not source.exists():
            available = ", ".join(sorted(f.stem for f in EXAMPLES.glob("*.md"))) or "none"
            fail(f"no example named '{args.from_example}'", f"available: {available}")
        body = source.read_text(encoding="utf-8")
    else:
        if not args.name:
            fail("a name is required", "usage: new-agent <name> --memory deliverable|caller")
        name = args.name
        if not args.memory:
            fail(
                "--memory is required",
                "Every agent with memory declares how the write happens:",
                "  deliverable  the memory file IS the output (prefer this)",
                "  caller       the agent returns findings, something else persists them",
                "There is deliberately no third option — see docs/design.md.",
            )
        body = render(
            (TEMPLATES / "agent.md").read_text(encoding="utf-8"), name, args.memory
        )

    if not NAME_RE.match(name):
        fail(
            f"invalid agent name '{name}'",
            "Use lowercase letters, digits and hyphens, 3-40 characters,",
            "starting with a letter. This becomes the filename and the",
            "identifier you call the agent by.",
        )

    agents_dir, memory_root = resolve_roots(args.agents_dir, args.memory_dir)
    definition = agents_dir / f"{name}.md"

    if definition.exists() and not args.force:
        fail(
            f"{definition} already exists",
            "Pass --force to overwrite it. Its memory is left untouched either way.",
        )

    agents_dir.mkdir(parents=True, exist_ok=True)
    definition.write_text(body, encoding="utf-8")
    index = write_memory(memory_root / name, name)

    memory_dir = index.parent
    print(f"definition  {definition}")
    print(f"memory      {memory_dir}/")
    print()

    if not args.from_example:
        print("Now write the personality — four fields in the definition: disposition,")
        print("voice, refusals, bar. Refusals is the one that matters; see README.md.")
        print(f"Worked example: {EXAMPLES.relative_to(REPO)}/toby.md")
        print()

    home = str(Path.home())
    shown = str(memory_dir.parent).replace(home, "~", 1)
    print("Run it as its own session (the form that also works from cron):")
    print()
    print(f'  echo "<task>" | claude -p --agent {name} \\')
    print(f"      --allowedTools Write Edit --add-dir {shown}")
    print()
    print("The prompt goes through stdin because --allowedTools and --add-dir are")
    print("variadic and would otherwise swallow a trailing prompt argument. Without")
    print(f"those two flags the agent cannot write to {shown} and the run records nothing.")
    print()
    print("Or from inside a session: open Claude Code and ask it to use the")
    print(f"{name} agent. Convenient, but session hooks do not fire for a subagent.")
    print()
    print("Verify with: tools/check")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
